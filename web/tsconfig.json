{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "newLine": "lf",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noEmitOnError": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "**/*.js",
    "**/*.mjs",
    "**/*.ts"
  ],
  "exclude": [
    "build.mjs",
    "**/*.test.*",
    "generated",
    "dist",
    "tooling",
    "node_modules"
  ]
}
