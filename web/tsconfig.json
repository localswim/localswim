{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noEmitOnError": true,
    "noEmit": true,
    "types": []
  },
  "include": ["**/*.js", "**/*.mjs", "**/*.ts"],
  "exclude": ["**/*.test.*", "node_modules", "generated", "dist", "build.mjs", "tooling"]
}
